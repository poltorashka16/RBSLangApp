<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RBSLangApp.Views.LessonTestsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Тест">

    <VerticalStackLayout Padding="20" Spacing="20">

        <Label Text="Проверь себя"
               FontSize="26"
               FontAttributes="Bold" />

        <Label x:Name="QuestionLabel"
               FontSize="20"
               FontAttributes="Bold" />

        <VerticalStackLayout Spacing="12">
            <Button x:Name="Option1" Clicked="Answer_Clicked" />
            <Button x:Name="Option2" Clicked="Answer_Clicked" />
            <Button x:Name="Option3" Clicked="Answer_Clicked" />
            <Button x:Name="Option4" Clicked="Answer_Clicked" />
        </VerticalStackLayout>

        <Label x:Name="ResultLabel"
               FontSize="16"
               HorizontalOptions="Center"
               TextColor="Gray" />

        <Button Text="Заново"
                Clicked="Restart_Clicked"
                BackgroundColor="#58CC02"
                TextColor="White"
                CornerRadius="16" />

    </VerticalStackLayout>
</ContentPage>