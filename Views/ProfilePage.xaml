<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RBSLangApp.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Профиль"
    BackgroundColor="White">

    <Grid RowDefinitions="Auto,*" Padding="0" RowSpacing="0">


        <VerticalStackLayout Grid.Row="0" 
                             Padding="20,20,20,0" 
                             Spacing="6"
                             BackgroundColor="White">
            <Label Text="RBSG LANGUAGE"
                   FontSize="12"
                   TextColor="#E31E24"
                   FontAttributes="Bold"
                   CharacterSpacing="2" />
            <Label Text="Профиль"
                   Style="{StaticResource TitleLabelStyle}" />
            <Label Text="Ваша статистика и настройки"
                   Style="{StaticResource SubtitleLabelStyle}" />
            <BoxView HeightRequest="1" Color="#F3F4F6" Margin="0,8,0,0" />
        </VerticalStackLayout>


        <ScrollView Grid.Row="1" Padding="20">
            <VerticalStackLayout Spacing="16">


                <Frame CornerRadius="8"
                       Padding="20"
                       BorderColor="#E5E7EB"
                       BackgroundColor="White"
                       HasShadow="False">
                    <VerticalStackLayout Spacing="12">

   
                        <Frame WidthRequest="64"
                               HeightRequest="64"
                               CornerRadius="32"
                               BackgroundColor="#FEF2F2"
                               Padding="0"
                               HasShadow="False"
                               BorderColor="#FECACA"
                               HorizontalOptions="Center">
                            <Label Text="👤"
                                   FontSize="28"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Frame>

                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label x:Name="UserNameLabel"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#111827"
                                   HorizontalTextAlignment="Center" />
                            <Label x:Name="UserLoginLabel"
                                   FontSize="14"
                                   TextColor="#6B7280"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Frame>


                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">


                    <Frame Grid.Column="0"
                           CornerRadius="8"
                           Padding="16"
                           BorderColor="#E5E7EB"
                           BackgroundColor="White"
                           HasShadow="False">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Frame WidthRequest="44"
                                   HeightRequest="44"
                                   CornerRadius="8"
                                   BackgroundColor="#FEF2F2"
                                   Padding="0"
                                   HasShadow="False"
                                   HorizontalOptions="Center">
                                <Label Text="⭐"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Frame>
                            <Label x:Name="FavoritesCountLabel"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="#E31E24"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Избранных слов"
                                   FontSize="12"
                                   TextColor="#6B7280"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Frame>


                    <Frame Grid.Column="1"
                           CornerRadius="8"
                           Padding="16"
                           BorderColor="#E5E7EB"
                           BackgroundColor="White"
                           HasShadow="False">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Frame WidthRequest="44"
                                   HeightRequest="44"
                                   CornerRadius="8"
                                   BackgroundColor="#FEF2F2"
                                   Padding="0"
                                   HasShadow="False"
                                   HorizontalOptions="Center">
                                <Label Text="📊"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Frame>
                            <Label x:Name="AverageResultLabel"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="#E31E24"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Средний балл"
                                   FontSize="12"
                                   TextColor="#6B7280"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Frame>

                </Grid>


                <BoxView HeightRequest="1" Color="#F3F4F6" Margin="0,4" />

                <Label Text="Действия"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#9CA3AF"
                       CharacterSpacing="1"
                       Margin="0,0,0,0" />


                <Button Text="⭐  ИЗБРАННЫЕ СЛОВА"
                        Style="{StaticResource MainButtonStyle}"
                        Clicked="OpenFavorites_Clicked"
                        HorizontalOptions="Fill" />

                <Button Text="📋  ИСТОРИЯ ТЕСТОВ"
                        BackgroundColor="#111827"
                        TextColor="White"
                        CornerRadius="4"
                        FontAttributes="Bold"
                        FontSize="14"
                        Padding="0,14"
                        Clicked="OpenProgress_Clicked"
                        HorizontalOptions="Fill" />

   
                <BoxView HeightRequest="1" Color="#F3F4F6" Margin="0,16,0,4" />


                <Button Text="ВЫЙТИ ИЗ АККАУНТА"
                        BackgroundColor="Transparent"
                        TextColor="#9CA3AF"
                        BorderColor="#E5E7EB"
                        BorderWidth="1"
                        CornerRadius="4"
                        FontSize="14"
                        FontAttributes="Bold"
                        Padding="0,14"
                        Clicked="Logout_Clicked"
                        HorizontalOptions="Fill" />


                <Label Text="RBSG Language App v1.0"
                       FontSize="11"
                       TextColor="#D1D5DB"
                       HorizontalOptions="Center"
                       Margin="0,16,0,0" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>