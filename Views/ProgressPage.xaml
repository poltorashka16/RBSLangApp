<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RBSLangApp.Views.ProgressPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="История тестов">

    <VerticalStackLayout Padding="18" Spacing="14">
        <Label Text="История тестов"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="White" />

        <CollectionView x:Name="ProgressCollection">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding LessonId, StringFormat='Урок № {0}'}"
                                   FontSize="18"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding Score, StringFormat='Результат: {0}'}" />
                            <Label Text="{Binding TotalQuestions, StringFormat='Всего вопросов: {0}'}" />
                            <Label Text="{Binding CompletionDate, StringFormat='Дата: {0:dd.MM.yyyy HH:mm}'}"
                                   TextColor="#6F7280" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
