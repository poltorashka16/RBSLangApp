<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RBSLangApp.Views.FavoritesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Избранное"
    BackgroundColor="White">

    <Grid RowDefinitions="Auto,*" Padding="0" RowSpacing="0">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" 
                             Padding="20,20,20,0" 
                             Spacing="6"
                             BackgroundColor="White">
            <Label Text="RBSG LANGUAGE"
                   FontSize="12"
                   TextColor="#E31E24"
                   FontAttributes="Bold"
                   CharacterSpacing="2" />
            <Label Text="Избранные слова"
                   Style="{StaticResource TitleLabelStyle}" />
            <Label Text="Ваша персональная подборка терминов"
                   Style="{StaticResource SubtitleLabelStyle}" />
            <BoxView HeightRequest="1" Color="#F3F4F6" Margin="0,8,0,0" />
        </VerticalStackLayout>

        <!-- Favorites List -->
        <CollectionView Grid.Row="1"
                        x:Name="FavoritesCollection"
                        Margin="20,12,20,20"
                        VerticalOptions="FillAndExpand">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,0,0,10"
                           Padding="16"
                           CornerRadius="8"
                           BorderColor="#E5E7EB"
                           BackgroundColor="White"
                           HasShadow="False">
                        <VerticalStackLayout Spacing="8">

                            <!-- Word & Actions -->
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <Label Text="{Binding EnglishWord}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#111827"
                                       VerticalOptions="Center" />

                                <Button Grid.Column="1"
                                        Text="🔊"
                                        Clicked="SpeakButton_Clicked"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#F3F4F6"
                                        TextColor="#374151"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        Padding="0"
                                        CornerRadius="4"
                                        FontSize="16" />

                                <Button Grid.Column="2"
                                        Text="✕"
                                        Clicked="RemoveButton_Clicked"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#FEF2F2"
                                        TextColor="#E31E24"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        Padding="0"
                                        CornerRadius="4"
                                        FontSize="16"
                                        FontAttributes="Bold" />
                            </Grid>

                            <!-- Translation -->
                            <Label Text="{Binding Translation}"
                                   FontSize="15"
                                   TextColor="#E31E24"
                                   FontAttributes="Bold" />

                            <!-- Example -->
                            <Frame BackgroundColor="#F9FAFB"
                                   CornerRadius="4"
                                   Padding="10"
                                   HasShadow="False"
                                   BorderColor="#F3F4F6">
                                <Label Text="{Binding Example}"
                                       FontSize="13"
                                       TextColor="#6B7280"
                                       FontAttributes="Italic" />
                            </Frame>

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Padding="40">
                    <Label Text="⭐"
                           FontSize="48"
                           HorizontalOptions="Center" />
                    <Label Text="Нет избранных слов"
                           FontSize="18"
                           TextColor="#6B7280"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           Margin="0,12,0,0" />
                    <Label Text="Добавляйте слова в избранное из уроков или словаря"
                           FontSize="14"
                           TextColor="#9CA3AF"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           Margin="0,4,0,0" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

    </Grid>
</ContentPage>