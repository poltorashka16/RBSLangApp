<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RBSLangApp.Views.FavoritesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Избранное">

    <VerticalStackLayout Padding="18" Spacing="14">
        <Label Text="Избранные слова"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="White" />

        <CollectionView x:Name="FavoritesCollection">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding EnglishWord}"
                                   FontSize="18"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding Translation}"
                                   FontSize="16"
                                   TextColor="#8E1F1F" />
                            <Label Text="{Binding Example}"
                                   FontSize="14"
                                   TextColor="#6F7280" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
