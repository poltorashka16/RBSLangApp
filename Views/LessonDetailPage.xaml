<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RBSLangApp.Views.LessonDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Карточки"
    BackgroundColor="White">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20" RowSpacing="20">

      
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="RBSG LANGUAGE"
                   FontSize="12"
                   TextColor="#E31E24"
                   FontAttributes="Bold"
                   CharacterSpacing="2" />
            <Label x:Name="LessonTitleLabel"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#111827" />
            <Label x:Name="LessonSubtitleLabel"
                   FontSize="14"
                   TextColor="#6B7280" />
            <Label x:Name="CounterLabel"
                   FontSize="13"
                   TextColor="#9CA3AF"
                   FontAttributes="Bold" />
        </VerticalStackLayout>

      
        <VerticalStackLayout Grid.Row="1"
                             VerticalOptions="Center"
                             Spacing="0">

            <Frame x:Name="CardFrame"
       CornerRadius="12"
       Padding="0"
       BorderColor="#E5E7EB"
       BackgroundColor="#FAFAFA"
       HasShadow="False"
       MinimumHeightRequest="300">

                <Grid>
                    <!-- Контент карточки -->
                    <Grid RowDefinitions="*,Auto" 
              VerticalOptions="Center" 
              RowSpacing="24"
              Padding="32">

                        <Label x:Name="CardMainTextLabel"
                   Grid.Row="0"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   TextColor="#111827" />

                        <Frame x:Name="ExampleFrame"
                   Grid.Row="1"
                   BackgroundColor="#FEF2F2"
                   CornerRadius="6"
                   Padding="12"
                   HasShadow="False"
                   BorderColor="#FECACA"
                   IsVisible="False">
                            <Label x:Name="CardExampleLabel"
                       FontSize="14"
                       TextColor="#991B1B"
                       HorizontalTextAlignment="Center"
                       FontAttributes="Italic" />
                        </Frame>
                    </Grid>

                    <!-- Прозрачная кнопка поверх -->
                    <Button x:Name="FlipButton"
                Opacity="0"
                Clicked="FlipCard_Clicked"
                HorizontalOptions="Fill"
                VerticalOptions="Fill" />
                </Grid>

            </Frame>
            
        </VerticalStackLayout>

   
        <VerticalStackLayout Grid.Row="2" Spacing="12">

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="🔊 ОЗВУЧИТЬ"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Clicked="SpeakButton_Clicked" />

                <Button Grid.Column="1"
                        Text="★ В ИЗБРАННОЕ"
                        Style="{StaticResource OutlineButtonStyle}"
                        Clicked="FavoriteButton_Clicked" />
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="← НАЗАД"
                        BackgroundColor="#F3F4F6"
                        TextColor="#374151"
                        CornerRadius="4"
                        FontAttributes="Bold"
                        FontSize="14"
                        Padding="0,14"
                        Clicked="PrevCard_Clicked" />

                <Button Grid.Column="1"
                        Text="ДАЛЕЕ →"
                        Style="{StaticResource MainButtonStyle}"
                        Clicked="NextCard_Clicked" />
            </Grid>

            <Button Text="ПРОЙТИ ТЕСТ"
                    BackgroundColor="#111827"
                    TextColor="White"
                    CornerRadius="4"
                    FontAttributes="Bold"
                    FontSize="14"
                    Padding="0,14"
                    Clicked="StartTest_Clicked" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>