<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RBSLangApp.Views.LessonsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:RBSLangApp.Models"
    Title="Обучение">

    <Grid RowDefinitions="Auto,*" Padding="0">

     
        <VerticalStackLayout Grid.Row="0" 
                             Padding="20,20,20,0" 
                             Spacing="6"
                             BackgroundColor="White">
            <Label Text="RBSG Language"
                   FontSize="14"
                   TextColor="#E31E24"
                   FontAttributes="Bold"
                   CharacterSpacing="2" />
            <Label Text="Учебные модули"
                   Style="{StaticResource TitleLabelStyle}" />
            <Label Text="Выберите модуль для изучения профессиональной лексики"
                   Style="{StaticResource SubtitleLabelStyle}" />

         
            <BoxView HeightRequest="1" 
                     Color="#F3F4F6" 
                     Margin="0,8,0,0" />
        </VerticalStackLayout>


        <CollectionView Grid.Row="1"
                        x:Name="LessonsCollection"
                        SelectionMode="None"
                        Margin="20,12,20,20">

            <CollectionView.Header>
                <Label Text="Доступные курсы"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#9CA3AF"
                       CharacterSpacing="1"
                       Margin="0,0,0,8" />
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Lesson">
                    <Frame Style="{StaticResource LessonCardStyle}">
                        <VerticalStackLayout Spacing="16">

                         
                            <Grid ColumnDefinitions="56,*" ColumnSpacing="16">

                               
                                <Frame WidthRequest="56"
                                       HeightRequest="56"
                                       CornerRadius="8"
                                       BackgroundColor="#FEF2F2"
                                       Padding="0"
                                       HasShadow="False"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       BorderColor="#FECACA">
                                    <Label Text="📘"
                                           FontSize="24"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Frame>

                                <VerticalStackLayout Grid.Column="1" 
                                                     Spacing="4"
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding Title}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#111827" />

                                    <Label Text="{Binding Subtitle}"
                                           FontSize="13"
                                           TextColor="#6B7280" />
                                </VerticalStackLayout>
                            </Grid>

                          
                            <VerticalStackLayout Spacing="8">

                              
                                <HorizontalStackLayout Spacing="8">
                                    <Frame BackgroundColor="#FEF2F2"
                                           CornerRadius="4"
                                           Padding="10,4"
                                           HasShadow="False"
                                           BorderColor="#FECACA">
                                        <Label Text="{Binding Level}"
                                               TextColor="#E31E24"
                                               FontSize="12"
                                               FontAttributes="Bold" />
                                    </Frame>

                                    <Frame BackgroundColor="#F3F4F6"
                                           CornerRadius="4"
                                           Padding="10,4"
                                           HasShadow="False"
                                           BorderColor="#E5E7EB">
                                        <Label Text="20 терминов"
                                               TextColor="#6B7280"
                                               FontSize="12" />
                                    </Frame>
                                </HorizontalStackLayout>

                            
                                <Label Text="{Binding Content}"
                                       FontSize="13"
                                       TextColor="#6B7280"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>

                      
                            <Button Text="НАЧАТЬ ОБУЧЕНИЕ →"
                                    Style="{StaticResource MainButtonStyle}"
                                    Clicked="OpenLesson_Clicked"
                                    CommandParameter="{Binding Id}"
                                    HorizontalOptions="Fill" />

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>